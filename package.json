{
  "name": "tic-tac-tierernaehrung",
  "version": "3.0.0-alpha",
  "private": true,
  "description": "3D-Browserspiel: heimlich Tic Tac Toe in der Tierernährungs-Vorlesung an der BOKU (Fan-Projekt)",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tools/test.mjs",
    "assets": "node tools/pipeline/fetch.mjs && node tools/pipeline/textures.mjs --profile desktop && node tools/pipeline/textures.mjs --profile mobile",
    "assets:fetch": "node tools/pipeline/fetch.mjs",
    "assets:check": "node tools/pipeline/fetch.mjs --check",
    "sharpness": "node tools/sharpness.mjs && node tools/sharpness-report.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/work-sans": "5.2.8",
    "hersheytext": "2.0.0",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.183.2",
    "troika-three-text": "^0.52.5"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "esbuild": "0.28.2",
    "gltfpack": "^1.3.0",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  }
}
